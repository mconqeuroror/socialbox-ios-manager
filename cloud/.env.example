# Admin account seeded on first run (created automatically at first login attempt).
# Login form accepts the username (not only email). Internally stored as
# <username>@redditbox.local unless ADMIN_EMAIL is set.
ADMIN_USERNAME=typekpaco
ADMIN_PASSWORD=change-me-please
# ADMIN_EMAIL=typekpaco@redditbox.local

# Secret used to sign session JWTs (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# JWT_SECRET is accepted as an alias for AUTH_SECRET.
AUTH_SECRET=generate-a-long-random-string
# JWT_SECRET=

# 32-byte hex/base64 AES-GCM key for per-profile rotation credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SECRETS_KEY=generate-a-64-character-hex-key

# Public URL of the app (used by device clients for the base URL)
APP_URL=http://localhost:3000

# Required for device activation. Set APP_URL to the canonical HTTPS origin
# used by the phone (no path/query). HTTP dev URLs can serve the console only.
# RSA >=2048-bit private PKCS#8 PEM, either real newlines or escaped \n.
# Generate outside the repository; set the matching PUBLIC PKCS#1 DER pin in
# the Mac build. Never commit this private key or place it in public/.
# LICENSE_SIGNING_PRIVATE_KEY=

# Optional: when set, storage switches from local .data/ to Vercel Blob.
# On Vercel, add the Vercel Blob integration and it sets this automatically.
# Create a PRIVATE store so users/licenses/pairing JSON are not public URLs.
# BLOB_READ_WRITE_TOKEN=
# Only set this if the attached store is still a legacy public store:
# BLOB_ACCESS=public

# Public APT binary artifacts use a DIFFERENT store from auth/backup data.
# Store host is non-secret, copied from that public store's Blob URLs.
# The publisher refuses a token whose embedded store ID differs from this host
# or matches the private BLOB_READ_WRITE_TOKEN store. Never reuse that token.
# APT_BLOB_READ_WRITE_TOKEN=
# APT_BLOB_HOST=yourstore.public.blob.vercel-storage.com
